# lhd.te

allow lhd {
    efs_file
    sec_efs_file
}:dir search;

allow lhd {
    sysfs_lhd
    sysfs_sec_sensorhub
}:dir search;

allow lhd {
    sysfs_lhd
    sysfs_sec_sensorhub
}:file rw_file_perms;

allow lhd sysfs_sec_gps:lnk_file r_file_perms;
allow lhd hal_system_suspend_service:service_manager find;
dontaudit lhd system_data_file:dir search;

# The GPS helper looks up the system suspend service.
binder_use(lhd)

# Broadcom GPS helper uses netd to mark network sockets.
unix_socket_connect(lhd, fwmarkd, netd)

# netd receives the socket descriptor in the fwmark request.
allow netd lhd:fd use;
