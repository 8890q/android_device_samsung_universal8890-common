# Audio
vendor_internal_prop(vendor_audio_prop);

# NFC
vendor_internal_prop(vendor_nfc_prop);

# OMX
vendor_internal_prop(vendor_omx_prop);

# Radio
vendor_internal_prop(clatd_radio_prop)

# Bluetooth controller firmware version, written by the Bluetooth HAL.
vendor_internal_prop(vendor_bluetooth_firmware_prop)

# Read-only configuration shared with audioserver and framework clients.
vendor_restricted_prop(vendor_audio_config_prop)
vendor_restricted_prop(vendor_wfd_config_prop)

get_prop({ appdomain bootanim surfaceflinger system_server }, vendor_wfd_config_prop)

# Camera framework reads this vendor-owned compatibility configuration.
vendor_restricted_prop(vendor_camera_config_prop)
get_prop({ appdomain cameraserver hal_camera_default }, vendor_camera_config_prop)
