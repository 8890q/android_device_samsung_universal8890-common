# ODM compatibility files live under system/vendor on this non-partitioned device.
# Keep the same policy-file types as the platform /vendor/odm rules.
/system/vendor/odm/etc/selinux/precompiled_sepolicy                                       u:object_r:sepolicy_file:s0
/system/vendor/odm/etc/selinux/precompiled_sepolicy\.plat_and_mapping\.sha256             u:object_r:sepolicy_file:s0
/system/vendor/odm/etc/selinux/odm_sepolicy\.cil                                          u:object_r:sepolicy_file:s0
/system/vendor/odm/etc/selinux/odm_file_contexts                                          u:object_r:file_contexts_file:s0
/system/vendor/odm/etc/selinux/odm_seapp_contexts                                         u:object_r:seapp_contexts_file:s0
/system/vendor/odm/etc/selinux/odm_property_contexts                                      u:object_r:property_contexts_file:s0
/system/vendor/odm/etc/selinux/odm_service_contexts                                       u:object_r:vendor_service_contexts_file:s0
/system/vendor/odm/etc/selinux/odm_hwservice_contexts                                     u:object_r:hwservice_contexts_file:s0
/system/vendor/odm/etc/selinux/odm_keystore2_key_contexts                                 u:object_r:keystore2_key_contexts_file:s0
/system/vendor/odm/etc/selinux/odm_mac_permissions\.xml                                   u:object_r:mac_perms_file:s0
/system/vendor/odm/etc/selinux/odm_tee_service_contexts                                   u:object_r:tee_service_contexts_file:s0

# Bionic also reads these ODM account databases through the canonical path.
# Match the platform's /vendor/odm/etc label without allowing generic vendor files.
/system/vendor/odm/etc/passwd    u:object_r:vendor_configs_file:s0
/system/vendor/odm/etc/group     u:object_r:vendor_configs_file:s0
